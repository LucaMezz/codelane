{
  "name": "@appkit/core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared framework-agnostic types, schemas, and utilities for AppKit.",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#metadata/*": "./src/metadata/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./metadata": "./src/metadata/index.ts"
  },
  "scripts": {
    "build": "pnpm clean && pnpm build:js && pnpm build:types",
    "build:js": "tsup",
    "build:types": "tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "typecheck": "tsgo --noEmit",
    "clean": "rimraf dist",
    "knip": "knip"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260507.1",
    "knip": "^6.12.1",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
