{
  "name": "@appkit/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Shared API client for AppKit web and desktop applications.",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "pnpm clean && pnpm build:js && pnpm build:types",
    "build:js": "tsup src/index.ts --format esm,cjs",
    "build:types": "tsc -p tsconfig.build.json",
    "dev": "tsup src/index.ts --format esm,cjs --watch",
    "typecheck": "tsgo --noEmit",
    "clean": "rimraf dist",
    "knip": "knip"
  },
  "dependencies": {
    "@appkit/config": "workspace:*",
    "@appkit/core": "workspace:*"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260507.1",
    "knip": "^6.12.1",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
