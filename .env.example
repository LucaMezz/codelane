# Server ports
API_PORT=4000
WEB_PORT=3000
DESKTOP_RENDERER_PORT=5173

# API base URL embedded into the browser bundle at Vite build time
VITE_API_BASE_URL=http://localhost:4000

# API and web URLs used by the CLI at runtime
CODELANE_API_URL=http://localhost:4000
CODELANE_WEB_URL=http://localhost:3000

# Allowed CORS origins for the API (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Auth.js signing secret — generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-long-random-string

# PostgreSQL connection (used by Docker Compose and Drizzle)
POSTGRES_PORT=5432
POSTGRES_DB=codelane
POSTGRES_USER=codelane
POSTGRES_PASSWORD=codelane
DATABASE_URL=postgres://codelane:codelane@localhost:5432/codelane
